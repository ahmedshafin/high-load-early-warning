# --- Python environment and caches ---
.venv/
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
*.egg-info/

# --- Editor and OS files ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Secrets (never commit these) ---
.env
*.key
*.pem
*cookies*.txt

# --- Data: large and regenerable (keep folder placeholders and the small sample) ---
data/raw/*
data/clean/*
data/model_ready/*
!data/raw/.gitkeep
!data/clean/.gitkeep
!data/model_ready/.gitkeep
!data/README.md
!data/sample/

# --- Generated model outputs: large, rebuilt by the pipeline ---
reports/tables/*_predictions.csv
reports/tables/*_val_predictions.csv
reports/tables/*_test_predictions.parquet
reports/tables/*_alert_episodes.csv
reports/tables/*_event_level_events.csv

